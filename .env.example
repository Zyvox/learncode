# Where the SQLite database lives (the directory is created if missing)
DATABASE_PATH=./data/learncode.sqlite
# Port and address the Node server listens on
PORT=3000
HOST=127.0.0.1

# ORIGIN: the public URL of the app, e.g. https://code.example.com
# - It is read at BUILD time (npm run build) and baked into the build for CSRF checks.
#   Set it when you run without a reverse proxy over plain http (local testing).
# - Behind a reverse proxy (Caddy/nginx) you can leave it unset at build time and instead set
#   PROTOCOL_HEADER / HOST_HEADER so the app derives the origin from forwarded headers.
# - At runtime it also decides whether the session cookie gets the Secure flag (https => Secure).
ORIGIN=http://localhost:3000

# Behind a reverse proxy (see deploy/):
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Where the SQL migrations live if you move the build somewhere else (default: ./drizzle)
# MIGRATIONS_PATH=/app/drizzle
