# Where the SQLite database lives (directory is created if missing)
DATABASE_PATH=./data/learncode.sqlite
# Port the Node server listens on
PORT=3000
# Public origin, needed for form actions / CSRF checks behind a reverse proxy
ORIGIN=http://localhost:3000
# Set to "1" to let the app trust X-Forwarded-* headers from your reverse proxy
# (adapter-node reads ADDRESS_HEADER / XFF_DEPTH; see README)
