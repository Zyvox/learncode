# systemd unit for running the app without Docker.
# 1. Build on the server:  npm ci && npm run build && npm prune --omit=dev
# 2. Copy this file to /etc/systemd/system/learncode.service, adjust paths/user/ORIGIN
# 3. systemctl daemon-reload && systemctl enable --now learncode
[Unit]
Description=learncode (learn-to-code web app)
After=network.target

[Service]
Type=simple
User=learncode
Group=learncode
WorkingDirectory=/opt/learncode
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=ORIGIN=https://code.example.com
Environment=DATABASE_PATH=/opt/learncode/data/learncode.sqlite
Environment=ADDRESS_HEADER=X-Forwarded-For
Environment=XFF_DEPTH=1
Environment=PROTOCOL_HEADER=x-forwarded-proto
Environment=HOST_HEADER=x-forwarded-host
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning build
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/learncode/data

[Install]
WantedBy=multi-user.target
